# DWSIM Configuration
DWSIM_PATH=C:/Program Files/DWSIM
# For Linux/Mac: /opt/DWSIM or /usr/local/DWSIM

# Simulation Settings
MAX_SIMULATION_TIME=30
LOG_LEVEL=INFO
DEFAULT_TEMPERATURE=298.15
DEFAULT_PRESSURE=101325

# Output Settings
SAVE_PLOTS=true
PLOT_FORMAT=png
GENERATE_HTML_REPORT=true

# Performance
USE_PARALLEL_PROCESSING=false
MAX_WORKERS=4